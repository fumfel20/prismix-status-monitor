{% extends 'base.html.twig' %}

{% block title %}Service Statuses{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Service Statuses</h1>
            <p class="text-muted mb-0">Monitor availability, latency, and uptime metrics from external API.</p>
        </div>
        <span class="badge bg-primary fs-6">{{ statuses|length }} service(s)</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="status-table" class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Description</th>
                            <th scope="col" style="width: 150px;">Latency</th>
                            <th scope="col" style="width: 170px;">Uptime 30d</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for status in statuses %}
                            <tr>
                                <td class="fw-semibold text-dark">
                                    {{ status.name }}
                                </td>
                                <td>
                                    <span class="text-secondary">{{ status.description }}</span>
                                </td>
                                <td>
                                    {% if status.latencyMs is not null %}
                                        <span class="badge bg-info-subtle text-info-emphasis font-monospace">
                                            {{ status.latencyMs }} ms
                                        </span>
                                    {% else %}
                                        <span class="badge bg-light text-muted border">No data</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if status.uptime30dPct is not null %}
                                        {% set badge_class = status.uptime30dPct >= 99.0 ? 'bg-success-subtle text-success-emphasis' : (status.uptime30dPct >= 95.0 ? 'bg-warning-subtle text-warning-emphasis' : 'bg-danger-subtle text-danger-emphasis') %}
                                        <span class="badge {{ badge_class }} font-monospace">
                                            {{ status.uptime30dPct|number_format(2, '.', '') }}%
                                        </span>
                                    {% else %}
                                        <span class="badge bg-light text-muted border">No data</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-exclamation-circle me-1"></i> Failed to fetch data or the status list is empty.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('vendor/tablefilter/dist/tablefilter/tablefilter.js') }}"></script>
    <script>
        function initStatusTableFilter() {
            var table = document.getElementById('status-table');
            if (!table || table.dataset.tfInitialized) {
                return;
            }
            table.dataset.tfInitialized = 'true';

            var filtersConfig = {
                base_path: '{{ asset('vendor/tablefilter/dist/tablefilter/') }}',
                col_0: 'input',
                col_1: 'input',
                col_2: 'input',
                col_3: 'input',
                col_types: [
                    'string',
                    'string',
                    'number',
                    'number'
                ],
                rows_counter: true,
                btn_reset: true,
                loader: true,
                status_bar: true,
                mark_active_columns: true,
                highlight_keywords: true,
                auto_filter: true,
                auto_filter_delay: 200,
                msg_filter: 'Filter...',
                btn_reset_text: 'Reset filters',
                rows_counter_text: 'Rows: '
            };

            if (typeof TableFilter !== 'undefined') {
                var tf = new TableFilter(table, filtersConfig);
                tf.init();
            }
        }

        document.addEventListener('DOMContentLoaded', initStatusTableFilter);
        document.addEventListener('turbo:load', initStatusTableFilter);
    </script>
{% endblock %}
